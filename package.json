{
  "name": "onegyeok",
  "version": "0.1.18",
  "description": "SSH/RDP/VNC/SFTP/Web 통합 원격 접속 클라이언트 (사내 ISMS 심사 대응 보안 정책 적용)",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:native": "make -C native/rdp-helper && make -C native/vnc-helper",
    "build:native:mac": "bash scripts/mac/build-native-deps.sh && make -C native/rdp-helper clean && make -C native/vnc-helper clean && make -C native/rdp-helper DEPS_PREFIX=$PWD/build/mac-deps/prefix && make -C native/vnc-helper DEPS_PREFIX=$PWD/build/mac-deps/prefix",
    "dist:mac": "npm run build:native:mac && electron-builder --mac dmg --arm64",
    "build:native:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/win/build-native.ps1",
    "dist:win": "npm run build:native:win && electron-builder --win nsis --x64",
    "postinstall": "node scripts/fix-node-pty.js"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "basic-ftp": "^6.2.2",
    "mssql": "^12.7.2",
    "mysql2": "^3.24.5",
    "node-pty": "^1.1.0",
    "pg": "^8.23.1",
    "ssh2": "^1.17.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "build": {
    "appId": "com.onegyeok.app",
    "productName": "onegyeok",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!node_modules/node-pty/{deps,src,third_party,scripts}/**",
      "!node_modules/node-pty/prebuilds/*/*.pdb"
    ],
    "extraResources": [
      {
        "from": "native/rdp-helper",
        "to": "native/rdp-helper",
        "filter": [
          "onegyeok-rdp-helper",
          "onegyeok-rdp-helper.exe"
        ]
      },
      {
        "from": "native/vnc-helper",
        "to": "native/vnc-helper",
        "filter": [
          "onegyeok-vnc-helper",
          "onegyeok-vnc-helper.exe"
        ]
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "15.0",
      "identity": "-",
      "hardenedRuntime": false,
      "files": [
        "src/**/*",
        "package.json",
        "!node_modules/node-pty/{deps,src,third_party,scripts}/**",
        "!node_modules/node-pty/prebuilds/*/*.pdb",
        "!node_modules/node-pty/prebuilds/win32-*/**",
        "!node_modules/node-pty/prebuilds/darwin-x64/**"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "src/**/*",
        "package.json",
        "!node_modules/node-pty/{deps,src,third_party,scripts}/**",
        "!node_modules/node-pty/prebuilds/*/*.pdb",
        "!node_modules/node-pty/prebuilds/darwin-*/**",
        "!node_modules/node-pty/prebuilds/win32-arm64/**"
      ],
      "extraResources": [
        {
          "from": "build/win-git/mingit",
          "to": "git",
          "filter": [
            "**/*",
            "!.onegyeok-mingit-version"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-x64.${ext}"
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false
  }
}
